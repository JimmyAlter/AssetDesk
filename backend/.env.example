PORT=4000
# Required when NODE_ENV=production; the server refuses to start with a missing or default secret.
JWT_SECRET=generate-a-long-random-value
# Comma-separated list of allowed browser origins. Outside production,
# http://localhost:* and http://127.0.0.1:* are also allowed.
CORS_ORIGIN=http://localhost:5173
# Express "trust proxy" setting: a hop count, true/false, or addresses.
# Defaults to 1 when NODE_ENV=production and false otherwise.
# TRUST_PROXY=1
# Optional. Defaults to backend/data/assetdesk.db
# DB_PATH=/opt/data/assetdesk.db
